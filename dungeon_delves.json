  {
    "id": "gnome_bathhouse",
    "name": "The Gnomish Bathhouse",
    "active": true,
    "hidden_until_discovered": true,
    "unlock_trigger": {
      "type": "quest_complete",
      "quest_id": "goo_bathhouse_flier"
    },
    "flavor": "A sweaty place, full of sweaty gnomes.  Woe to ye who enters here.",
    "rooms": [
      {
        "id": "The Sewer",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "bad_rat",
              "bad_rat"
            ],
            "fork": false
          },
          {
            "monsters": [
              "feral_goo",
              "feral_goo"
            ],
            "fork": false
          }
        ],
        "next": "The Doorman",
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_The Sewer.jpg"
      },
      {
        "id": "The Doorman",
        "type": "choice",
        "prompt": "You finally make it to the entrance of the bathhouse.  Looks like they've got a coat check here too but... that coat check guy looks familiar.\r\n\r\nToo familiar.\r\n\r\nSeems like they might recognize you too.  What do you do?",
        "actions": [
          {
            "label": "Act Natural",
            "check": {
              "stat": "speed",
              "dc": 15
            },
            "on_success": {
              "next": "The Bathhouse",
              "message": "You slip right past him before they're able to put anything together.  Sucker."
            },
            "on_fail": {
              "next": "Fight the Doorman",
              "message": "A hand on your shoulder stops you.  Uh oh."
            },
            "x": 336.0,
            "y": 188.0
          },
          {
            "label": "Beat this nerd up again",
            "on_success": {
              "next": "Fight the Doorman",
              "message": "You don't got no time for wimps like this guy."
            },
            "x": 336.0,
            "y": 336.0
          }
        ],
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_The Doorman.jpg"
      },
      {
        "id": "The Bathhouse",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "enchanted_comb",
              "enchanted_soap"
            ],
            "fork": false,
            "party_extra_monster": "enchanted_towel"
          },
          {
            "monsters": [
              "enchanted_comb",
              "enchanted_towel"
            ],
            "fork": false,
            "party_extra_monster": "enchanted_soap"
          }
        ],
        "next": "A Private Bath",
        "prompt": "As you enter the Bathhouse proper, you are immediately assaulted by what appears to be a selection of malfunctioning, yet still magical, bath accessories."
      },
      {
        "id": "Fight the Doorman",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "gnome_doorman"
            ],
            "fork": false
          }
        ],
        "next": "The Bathhouse",
        "prompt": "\"YOU AGAIN?  OH HOW I HAVE WAITED FOR THIS MOMENT.  YOU MAY HAVE GOT ME FIRED FROM MY LAST JOB, BUT I HAVE BEEN TRAINING EVERY WAKING MOMENT FOR THE CHANCE THAT I GET MY REVENGE\"\r\n\r\nThe Gnome...er.... Goblin's dorky, nasal voice is really starting to grate on your nerves.\r\n\r\n\"EN GARDE, MY NEMESIS.\"\r\n\r\nOh that is -it-."
      },
      {
        "id": "A desperate choice!",
        "type": "choice",
        "prompt": "The gnomes are gaining on you. Soaked, furious, and closing fast.\r\n\r\nUp ahead: a beaded curtain, glowing red, reeking of sweat and leather. Or a crack in the pipes, just barely wide enough to squeeze through, that might lead outside.\r\n\r\nNo time to think. Pick one.",
        "actions": [
          {
            "label": "Squeeze into the pipe",
            "on_success": {
              "next": "The Bog of Z'Goolok"
            },
            "x": 1473.0,
            "y": 385.0
          },
          {
            "label": "Push through the curtain",
            "on_success": {
              "next": "The Leather Daddy's Private Room"
            },
            "x": 1471.0,
            "y": 478.0
          }
        ],
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_A desperate choice!.jpg"
      },
      {
        "id": "The Bog of Z'Goolok",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "z_goolok"
            ],
            "fork": false,
            "party_extra_monster": "feral_goo"
          }
        ],
        "prompt": "The pipe spits you out into damp darkness. Not outside, like you'd hoped.\r\n\r\nThe air is heavy and old, thick with rot and something fouler underneath. Stagnant water laps at your ankles, and you can just make out shapes beneath the surface. Bones, maybe. Or something that used to have them.\r\n\r\nWhatever has been sleeping down here has been sleeping for a very long time. You get the distinct feeling you just woke it up.",
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_The Bog of Z'Goolok.jpg"
      },
      {
        "id": "The Leather Daddy's Private Room",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "gnome_leather_daddy"
            ],
            "fork": false,
            "party_extra_monster": "nakedgnome_1"
          }
        ],
        "prompt": "You shove through the curtain into velvet and candlelight, pumping techno bleeding through the walls from somewhere unseen.\r\n\r\nThe walls are hung with things you don't want to look at too closely: leather straps, polished chains, hooks that definitely aren't for towels. The air is thick with candle wax, sweat, and something sweeter underneath.\r\n\r\nSomeone has been very busy in here. And they don't look happy to be interrupted.",
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_The Leather Daddy's Private Room.jpg"
      },
      {
        "id": "A Private Bath",
        "type": "combat",
        "monster_groups": [
          {
            "monsters": [
              "nakedgnome_1",
              "nakedgnome_2"
            ],
            "chance": 0.333,
            "fork": true,
            "next": "Sneaky Hobos",
            "x": 880.0,
            "y": 318.0,
            "party_extra_monster": "nakedgnome_3"
          },
          {
            "monsters": [
              "nakedgnome_1",
              "nakedgnome_3"
            ],
            "chance": 0.333,
            "fork": true,
            "next": "Sneaky Hobos",
            "x": 1046.0,
            "y": 420.0,
            "party_extra_monster": "nakedgnome_2"
          },
          {
            "monsters": [
              "nakedgnome_2",
              "nakedgnome_3"
            ],
            "chance": 0.333,
            "fork": true,
            "next": "Sneaky Hobos",
            "x": 851.0,
            "y": 450.0,
            "party_extra_monster": "nakedgnome_1"
          },
          {
            "monsters": [
              "enchanted_towel",
              "bath_witch"
            ],
            "chance": 0.25,
            "fork": true,
            "next": "Witch Meltdown",
            "x": 1052.0,
            "y": 87.0,
            "party_extra_monster": "enchanted_comb"
          }
        ],
        "prompt": "As you remove the curtains to enter in what you think is the main room, it turns out you stumble into a private bath!"
      },
      {
        "id": "Witch Meltdown",
        "type": "choice",
        "prompt": "The Frustrated Witch lies slumped against the tub, wheezing. Behind her, the floating bath apparatus she'd been wrangling all fight is now completely unsupervised and spinning wildly out of control as they spray suds -everywhere-.",
        "actions": [
          {
            "label": "Help her wrangle it",
            "check": {
              "stat": "atk",
              "dc": 35
            },
            "on_success": {
              "next": "A desperate choice!",
              "message": "Between the two of you, you wrestle the apparatus back under control. She glares at you, snatching it back. \"Thanks... I guess. Don't think this makes us friends.  The next time I see you, I'm still kicking your ass.\"",
              "achievement_kind": "bath_witch_befriended"
            },
            "on_fail": {
              "next": "A desperate choice!",
              "hp_delta": -10,
              "message": "You lunge for it. It does not want to be caught. It backhands you with what you can only describe as soap-slicked vengeance."
            },
            "x": 1457.0,
            "y": 191.0
          },
          {
            "label": "Leave her to it",
            "on_success": {
              "next": "A desperate choice!",
              "message": "You decide this is not your problem and step over her, leaving her to fight the apparatus alone. Her muffled cursing follows you out."
            },
            "x": 1235.0,
            "y": 199.0
          }
        ],
        "background_path": "assets/dungeon/backgrounds/gnome_bathhouse_room_Witch Meltdown.gif"
      },
      {
        "id": "Sneaky Hobos",
        "type": "choice",
        "prompt": "You stop to catch your breath -- and notice you're not alone. A ragged group of hobos is huddled in the corner around a suspiciously well-organized dice game, using what you can only assume are stolen towels as a table cloth.",
        "actions": [
          {
            "label": "Tattle on them",
            "check": {
              "chance": 0.6
            },
            "on_success": {
              "next": "A desperate choice!",
              "message": "You flag down a bathhouse attendant and quietly point out the hobos. They slip you a little something for your trouble before hauling the group off, muttering about \"freeloaders.\"",
              "currency_delta": 50
            },
            "on_fail": {
              "next": "Angry Gnomes",
              "message": "The attendant squints at you, then at the huddled hobos, then back at you. \"Wait... you're the one that's been causing trouble.\""
            },
            "x": 1233.0,
            "y": 786.0
          },
          {
            "label": "GAMBLE!!",
            "cost": {
              "currency": 50
            },
            "check": {
              "chance": 0.5
            },
            "on_success": {
              "next": "A desperate choice!",
              "message": "You buy in and snatch the dice before any hobo can do their hobo hexes on them.  You blow on them and throw them down.  Seven!  That's a winner!",
              "currency_delta": 100
            },
            "on_fail": {
              "next": "A desperate choice!",
              "message": "You buy in, but once the game starts the hobo's hands move so fast you can't even see what is happening.  Before you know it, you've lost.  You suspect the dice were never fair to begin with."
            },
            "x": 1136.0,
            "y": 575.0
          }
        ]
      },
      {
